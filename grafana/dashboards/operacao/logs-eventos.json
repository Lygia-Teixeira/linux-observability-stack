    {
      "id": 6,
      "type": "table",
      "title": "Top servicos com erros/avisos",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by(unit) (count_over_time({host=~\"$host\", categoria=~\"$categoria\", unit=~\"$unit\"} |~ \"(?i)error|warning|critical|fatal\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{unit}}"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "labelsToFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "unit",
              "Last *": "Valor",
              "Last (not null)": "Valor"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Valor",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
