        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "nivel",
        "label": "Nivel",
        "type": "custom",
        "multi": false,
        "includeAll": false,
        "query": "Tudo : .*,Atencao : (?i)error|warning|failed|denied|blocked|critical|fatal,Erro : (?i)error|critical|fatal,Aviso : (?i)warn,Bloqueio : (?i)blocked|denied,Falha de login : (?i)failed password|authentication failure|invalid user",
        "options": [],
        "current": {
          "selected": true,
          "text": "Tudo",
          "value": ".*"
        }
      },
      {
        "name": "busca",
        "label": "Busca",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
