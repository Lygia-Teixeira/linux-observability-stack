          },
          "expr": "sum by(host) (count_over_time({host=~\"$host\", categoria=~\"$categoria\", unit=~\"$unit\"} |~ \"$nivel\" |~ \"(?i)$busca\" [$__auto]))",
          "legendFormat": "{{host}}"
