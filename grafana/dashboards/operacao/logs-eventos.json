            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({host=~\"$host\", categoria=~\"$categoria\", unit=~\"$unit\"} |~ \"$nivel\" |~ \"(?i)$busca\" [$__range]))",
          "queryType": "instant"
