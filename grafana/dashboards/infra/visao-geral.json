            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by(instance) ((100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)) > 70 or on(instance) (100 * (1 - (avg by(instance) (node_memory_MemAvailable_bytes) / avg by(instance) (node_memory_MemTotal_bytes)))) > 70 or on(instance) (100 - (avg by(instance) (node_filesystem_avail_bytes{mountpoint=\"/\"}) / avg by(instance) (node_filesystem_size_bytes{mountpoint=\"/\"}) * 100)) > 70) unless on(instance) ((100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)) > 85 or on(instance) (100 * (1 - (avg by(instance) (node_memory_MemAvailable_bytes) / avg by(instance) (node_memory_MemTotal_bytes)))) > 85 or on(instance) (100 - (avg by(instance) (node_filesystem_avail_bytes{mountpoint=\"/\"}) / avg by(instance) (node_filesystem_size_bytes{mountpoint=\"/\"}) * 100)) > 85 or on(instance) (max by(instance) (up{job=~\"node-exporter.*\"}) == 0)))",
          "instant": true,
          "range": false
