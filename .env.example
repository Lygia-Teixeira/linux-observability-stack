# Copie para .env e ajuste. Proteja o arquivo: chmod 600 .env
# Nunca versione o .env real. Guarde os segredos em um cofre de senhas.

# --- Grafana: conta administrativa ---
# Evite o usuario padrao "admin".
GF_ADMIN_USER=CHANGE_ME
GF_ADMIN_PASSWORD=CHANGE_ME

# URL publica do Grafana (se houver proxy reverso com TLS). Sem proxy, deixe localhost.
GF_ROOT_URL=http://localhost:3000
# true quando o Grafana estiver atras de HTTPS
GF_COOKIE_SECURE=false

# --- Alertas por e-mail (SMTP externo) ---
# Use um provedor SMTP externo com senha de aplicacao, para nao alterar o MTA
# (Exim/Postfix) dos servidores de producao.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=CHANGE_ME
GF_SMTP_PASSWORD=CHANGE_ME
GF_SMTP_FROM_ADDRESS=alerts@example.com
GF_SMTP_FROM_NAME=Monitoramento

# Destinatario dos alertas (usado no provisionamento do contact point)
ALERT_EMAIL=alerts@example.com

# --- Prometheus ---
PROMETHEUS_RETENTION=15d
